+Fixpoint all_in_range (lo hi : Z) (ks : list cell) : bool :=
+  match ks with
+  | [] => true
+  | KInt v :: r => (lo <=? v) && (v <=? hi) && all_in_range lo hi r
+  | _ :: _ => false
+  end.
