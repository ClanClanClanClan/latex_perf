; The strict-tier kernel L_S0 (ADR-012, milestone M2 phase 1) and its decision on
; bytes (phase 2). Deliberately a separate library that no product executable
; links: the kernel runs only in its evidence (the generated differentials and
; the signature probes) and in strict_decide.exe's file mode, and the CLI's
; strict tier stays a stub until M3.

(library
 (name strict_kernel)
 (wrapped false)
 (modules strict_kernel_extracted strict_bytes_extracted))

(executable
 (name strict_decide)
 (modules strict_decide)
 (libraries strict_kernel yojson))

(test
 (name test_strict_kernel)
 (modules test_strict_kernel)
 (libraries strict_kernel))

(test
 (name test_strict_bytes)
 (modules test_strict_bytes)
 (libraries strict_kernel))
